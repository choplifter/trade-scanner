# Copy this file to .env and fill in your Alpaca paper-trading API credentials.
# Sign up free at https://alpaca.markets, create a paper trading account, then
# generate keys under "API Keys" in the dashboard.
ALPACA_API_KEY_ID=your_key_id_here
ALPACA_API_SECRET_KEY=your_secret_key_here
ALPACA_PAPER=true

# "iex" is Alpaca's free real-time feed (single-exchange, not the full tape).
# Switch to "sip" only if you upgrade to a paid Alpaca market-data subscription.
ALPACA_DATA_FEED=iex

# Scanner polling cadence (seconds). Premarket is slower by default since
# volume/volatility is lower and there's less need to hammer the API.
SCANNER_POLL_INTERVAL_REGULAR=5.0
SCANNER_POLL_INTERVAL_PREMARKET=10.0

# Universe filters: which symbols are even considered for scanning.
UNIVERSE_MIN_PRICE=1.0
UNIVERSE_MAX_PRICE=50.0
UNIVERSE_MIN_AVG_VOLUME=300000
MAX_UNIVERSE_SIZE=2000

# Max symbols simultaneously streamed live (chart widgets). Free IEX websocket
# has practical limits, so this is a safety cap.
MAX_STREAM_SYMBOLS=30

CORS_ORIGINS=["http://localhost:5173"]

# Optional: powers the "AI Trade Ideas" widget (turns current scanner rows
# into short descriptive commentary via the Claude API). Get a key at
# https://console.anthropic.com -> API Keys. Everything else in the app
# works fine without this set.
ANTHROPIC_API_KEY=
