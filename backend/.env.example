# Copy this file to .env and fill in your Alpaca paper-trading API credentials.
# Sign up free at https://alpaca.markets, create a paper trading account, then
# generate keys under "API Keys" in the dashboard.
ALPACA_API_KEY_ID=your_key_id_here
ALPACA_API_SECRET_KEY=your_secret_key_here
ALPACA_PAPER=true

# "sip" is the consolidated tape (every exchange, the real volume) and needs a
# paid Alpaca market-data subscription. "iex" is the free single-exchange feed
# -- it works, but every volume *level* it reports (volume_today, dollar
# volume, RVOL, volume surge) is a small and symbol-dependent fraction of
# reality; ratios like gap % and VWAP survive it fine.
ALPACA_DATA_FEED=sip

# Scanner polling cadence (seconds). Premarket is slower by default since
# volume/volatility is lower and there's less need to hammer the API.
SCANNER_POLL_INTERVAL_REGULAR=5.0
SCANNER_POLL_INTERVAL_PREMARKET=10.0

# Measure RVOL against the volume normally traded by *this time of day*, rather
# than against a full-day average. Strictly more correct -- raw RVOL understates
# by roughly 20x at 09:35 and converges to correct only by the close -- but off
# by default: it rescales RVOL, and the 15x fade-risk threshold was calibrated
# against the un-normalized definition. Re-derive that threshold from fresh
# scanner_history data before relying on this.
SCANNER_RVOL_TIME_NORMALIZED=false

# Universe filters: which symbols are even considered for scanning.
# $5 floor excludes SEC-defined "penny stocks" -- thin liquidity and wide
# spreads below that make for erratic prints and closer to gambling than a
# real edge-driven setup.
UNIVERSE_MIN_PRICE=5.0
UNIVERSE_MAX_PRICE=50.0
UNIVERSE_MIN_AVG_VOLUME=300000
MAX_UNIVERSE_SIZE=2000

# Max symbols simultaneously streamed live (chart widgets). A safety cap
# against runaway subscriptions, not a feed limit -- but drop it to 30 on the
# free plan, whose websocket won't carry more than that.
MAX_STREAM_SYMBOLS=200

# Default trailing window for the volume-rate columns (RVol (window),
# Volume Concentration). A screen can override it per screen without a
# restart -- this is only the fallback the fixed views run on. Shorter
# windows become readable earlier in the session: the reading needs one full
# window elapsed since the open before it means anything.
SCANNER_VOLUME_SURGE_WINDOW_MINUTES=60

CORS_ORIGINS=["http://localhost:5173"]

# Optional: powers the "AI Trade Ideas" widget (turns current scanner rows
# into short descriptive commentary via the Claude API). Get a key at
# https://console.anthropic.com -> API Keys. Everything else in the app
# works fine without this set.
ANTHROPIC_API_KEY=

# Optional: float + market cap Alpaca doesn't provide. Free key at
# https://site.financialmodelingprep.com. Leaves those fields (and
# short_interest_pct, which is derived from float) null when unset.
# Short interest itself needs no key -- it's pulled from FINRA's free
# public bulk data (see app/fundamentals/finra_short_interest.py) and
# combined with FMP's float to compute a percentage.
FMP_API_KEY=
# How often (seconds) a given symbol's fundamentals are re-fetched. Only
# symbols currently in a ranked scanner view are fetched at all, so this
# can be fairly long -- float/market cap rarely change intraday and short
# interest is only reported biweekly by FINRA.
FUNDAMENTALS_REFRESH_INTERVAL=21600

# --- Trading panel ------------------------------------------------------
# Master switch for order placement. Read paths (account, positions, order
# history) work regardless -- this only gates writes. Off by default so
# pulling this feature cannot place an order until you opt in.
TRADING_ENABLED=false

# There is no setting that enables LIVE trading. With ALPACA_PAPER=false the
# order endpoints refuse outright rather than arming real money; the refusal
# lives in app/trading/service.py and removing it is a deliberate code change.

# Fat-finger ceilings, checked before an order reaches the broker. The
# percentage is the one that scales: sizing from a stop makes
# notional = risk x (entry / stop-distance), so even a 1% risk builds a
# position many times that size when the stop is tight. A fixed dollar
# ceiling that looks cautious will silently block every realistic trade.
TRADING_MAX_ORDER_NOTIONAL_PCT=25
# Absolute backstop, applied as well -- bounds the order even if equity is
# ever misreported.
TRADING_MAX_ORDER_NOTIONAL=25000
TRADING_MAX_ORDER_QTY=10000

# Default share of equity risked per trade when sizing from a stop.
TRADING_DEFAULT_RISK_PCT=1.0
